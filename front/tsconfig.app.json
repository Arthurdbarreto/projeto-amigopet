    "src/app/layout/app.menu.component.ts",
    "src/app/layout/app.menuitem.component.ts",
    "src/app/layout/app.sidebar.component.ts",
    "src/app/layout/app.topbar.component.ts",
    "src/app/layout/config/app.config.component.ts"
  ]
}
